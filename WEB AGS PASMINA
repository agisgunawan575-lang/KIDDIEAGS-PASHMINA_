                    <div class="p-5 pt-3 border-t border-cream-100 flex items-center justify-between gap-2">
                        <div>
                            <p class="text-[10px] text-mocha-700">Harga Satuan</p>
                            <p class="font-serif text-xl font-bold text-mocha-900">${formatRupiah(product.price)}</p>
                        </div>
                        <button onclick="addToCart('${product.id}')" 
                                class="px-4 py-2.5 rounded-xl bg-mocha-900 hover:bg-sage-600 text-cream-50 text-xs font-semibold transition-all flex items-center gap-1.5 shadow-sm active:scale-95">
                            <i class="fa-solid fa-plus text-[10px]"></i>
                            <span>Keranjang</span>
                        </button>
                    </div>
                </div>
                `;
            }).join('');
        }

        // Pilih Warna Produk
        function selectColor(productId, colorIndex) {
            const product = products.find(p => p.id === productId);
            if (product) {
                selectedColors[productId] = product.colors[colorIndex];
                renderProducts();
            }
        }

        // Filter Kategori
        function filterCategory(category) {
            activeCategory = category;
            document.querySelectorAll('.cat-btn').forEach(btn => {
                if (btn.dataset.cat === category) {
                    btn.classList.remove('bg-cream-100', 'text-mocha-800');
                    btn.classList.add('bg-sage-600', 'text-white');
                } else {
                    btn.classList.remove('bg-sage-600', 'text-white');
                    btn.classList.add('bg-cream-100', 'text-mocha-800');
                }
            });
            renderProducts();
        }

        // Pencarian
        function handleSearch(val) {
            searchQuery = val.trim();
            renderProducts();
        }

        // Reset Filter
        function resetFilters() {
            activeCategory = "Semua";
            searchQuery = "";
            document.getElementById('search-input').value = "";
            filterCategory("Semua");
        }

        // Tambah ke Keranjang
        function addToCart(productId) {
            const product = products.find(p => p.id === productId);
            const color = selectedColors[productId];
            const itemKey = `${product.id}_${color.name}`;

            const existingItem = cart.find(item => item.key === itemKey);
            if (existingItem) {
                existingItem.qty += 1;
            } else {
                cart.push({
                    key: itemKey,
                    productId: product.id,
                    name: product.name,
                    colorName: color.name,
                    colorHex: color.hex,
                    price: product.price,
                    qty: 1
                });
            }

            updateCartUI();
            showToast(`<b>${product.name}</b> (${color.name}) ditambahkan ke keranjang!`);
        }

        // Ubah Jumlah Item di Keranjang
        function updateItemQty(key, delta) {
            const index = cart.findIndex(item => item.key === key);
            if (index === -1) return;

            cart[index].qty += delta;
            if (cart[index].qty <= 0) {
                cart.splice(index, 1);
            }
            updateCartUI();
        }

        // Hapus Item dari Keranjang
        function removeItem(key) {
            cart = cart.filter(item => item.key !== key);
            updateCartUI();
        }

        // Render & Update UI Keranjang
        function updateCartUI() {
            const badge = document.getElementById('header-cart-badge');
            const subtitle = document.getElementById('cart-subtitle');
            const container = document.getElementById('cart-items-container');
            const formSection = document.getElementById('checkout-form-section');
            const footer = document.getElementById('cart-footer');
            const subtotalEl = document.getElementById('cart-subtotal');
            const totalEl = document.getElementById('cart-total');
            const totalQtyText = document.getElementById('total-qty-text');
            const promoNotice = document.getElementById('promo-notice');

            const totalQty = cart.reduce((sum, item) => sum + item.qty, 0);
            const totalPrice = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);

            badge.textContent = totalQty;
            subtitle.textContent = `${totalQty} item dipilih`;

            if (cart.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-12 px-4 bg-white rounded-3xl border border-cream-200">
                        <div class="w-16 h-16 rounded-full bg-cream-100 text-sage-600 flex items-center justify-center mx-auto mb-3 text-2xl">
                            <i class="fa-solid fa-bag-shopping"></i>
                        </div>
                        <h4 class="font-serif text-xl font-bold text-mocha-900">Keranjang Masih Kosong</h4>
                        <p class="text-xs text-mocha-700 mt-1 mb-5">Yuk pilih model dan warna pasmina favoritmu di katalog!</p>
                        <button onclick="toggleCart(false)" class="px-5 py-2.5 rounded-xl bg-sage-600 text-white text-xs font-semibold hover:bg-sage-700">
                            Lihat Katalog Pasmina
                        </button>
                    </div>
                `;
                formSection.classList.add('hidden');
                footer.classList.add('hidden');
                return;
            }

            formSection.classList.remove('hidden');
            footer.classList.remove('hidden');

            if (totalQty >= 3) {
                promoNotice.classList.remove('hidden');
            } else {
                promoNotice.classList.add('hidden');
            }

            subtotalEl.textContent = formatRupiah(totalPrice);
            totalEl.textContent = formatRupiah(totalPrice);
            totalQtyText.textContent = totalQty;

            container.innerHTML = cart.map(item => `
                <div class="bg-white p-3.5 rounded-2xl border border-cream-200 flex items-center justify-between gap-3 shadow-sm">
                    <div class="flex items-center gap-3 min-w-0">
                        <div class="w-11 h-11 rounded-xl flex-shrink-0 flex items-center justify-center border border-black/10 shadow-inner"
                             style="background-color: ${item.colorHex};">
                            <i class="fa-solid fa-scarf text-white/80 text-sm"></i>
                        </div>
                        <div class="min-w-0">
                            <h5 class="text-xs font-bold text-mocha-900 truncate">${item.name}</h5>
                            <p class="text-[11px] text-mocha-700">Warna: <span class="font-semibold">${item.colorName}</span></p>
                            <p class="text-xs font-bold text-sage-700 mt-0.5">${formatRupiah(item.price * item.qty)}</p>
                        </div>
                    </div>

                    <div class="flex items-center gap-1.5 flex-shrink-0">
                        <button onclick="updateItemQty('${item.key}', -1)" 
                                class="w-7 h-7 rounded-lg bg-cream-100 hover:bg-cream-200 text-mocha-900 text-xs font-bold flex items-center justify-center">
                            -
                        </button>
                        <span class="w-6 text-center text-xs font-bold text-mocha-900">${item.qty}</span>
                        <button onclick="updateItemQty('${item.key}', 1)" 
                                class="w-7 h-7 rounded-lg bg-cream-100 hover:bg-cream-200 text-mocha-900 text-xs font-bold flex items-center justify-center">
                            +
                        </button>
                        <button onclick="removeItem('${item.key}')" 
                                class="w-7 h-7 rounded-lg text-dusty-600 hover:bg-dusty-100 text-xs flex items-center justify-center ml-1"
                                title="Hapus">
                            <i class="fa-regular fa-trash-can"></i>
                        </button>
                    </div>
                </div>
            `).join('');
        }

        // Susun Format Pesan WhatsApp & Link Pemesanan
        function generateOrderSummary() {
            const name = document.getElementById('cust-name').value.trim() || "(Belum diisi)";
            const address = document.getElementById('cust-address').value.trim() || "(Belum diisi)";
            const shipping = document.getElementById('cust-shipping').value;
            const note = document.getElementById('cust-note').value.trim() || "-";

            let totalQty = 0;
            let totalPrice = 0;
            let itemLines = "";

            cart.forEach((item, idx) => {
                const sub = item.price * item.qty;
                totalQty += item.qty;
                totalPrice += sub;
                itemLines += `${idx + 1}. *${item.name}*\n   • Warna: ${item.colorName}\n   • Jumlah: ${item.qty} pcs (${formatRupiah(sub)})\n`;
            });

            const bonusText = totalQty >= 3 ? "\n🎁 *Bonus:* Gratis Jarum Pentul Eksklusif (Min. 3 pcs)" : "";

            const message = 
`Halo Admin *AGS Pasmina* 🤍
Saya ingin memesan koleksi kerudung pasmina berikut:

*DETAIL PESANAN:*
${itemLines}
*Total Item:* ${totalQty} pcs
*Total Harga:* ${formatRupiah(totalPrice)}${bonusText}

*DATA PEMESAN:*
• Nama: ${name}
• Alamat: ${address}
• Pengiriman: ${shipping}
• Catatan: ${note}

Mohon konfirmasi ketersediaan stok dan total ongkirnya ya Kak. Terima kasih! 🙏`;

            const encodedMessage = encodeURIComponent(message);
            const waLink = `https://wa.me/${STORE_WA_NUMBER}?text=${encodedMessage}`;

            return { message, waLink };
        }

        // Eksekusi Checkout ke WhatsApp
        function checkoutWhatsApp() {
            if (cart.length === 0) return;

            const nameInput = document.getElementById('cust-name');
            const addressInput = document.getElementById('cust-address');

            if (!nameInput.value.trim()) {
                nameInput.focus();
                showToast("⚠️ Mohon isi <b>Nama Pemesan</b> terlebih dahulu.");
                return;
            }
            if (!addressInput.value.trim()) {
                addressInput.focus();
                showToast("⚠️ Mohon isi <b>Alamat Pengiriman</b> terlebih dahulu.");
                return;
            }

            const { waLink } = generateOrderSummary();
            window.open(waLink, '_blank', 'noopener,noreferrer');
        }

        // Salin Link & Rincian Pesanan ke Clipboard
        function copyOrderLink() {
            if (cart.length === 0) return;

            const { message, waLink } = generateOrderSummary();
            const fullCopyText = `${message}\n\n🔗 Link Pemesanan Langsung:\n${waLink}`;

            // Menggunakan metode textarea + execCommand agar kompatibel di dalam iframe
            const tempTextArea = document.createElement('textarea');
            tempTextArea.value = fullCopyText;
            document.body.appendChild(tempTextArea);
            tempTextArea.select();
            try {
                document.execCommand('copy');
                showToast("✅ Format & link pesanan berhasil disalin!");
            } catch (err) {
                showToast("❌ Gagal menyalin teks pesanan.");
            }
            document.body.removeChild(tempTextArea);
        }

        // Toggle Drawer Keranjang
        function toggleCart(open) {
            const drawer = document.getElementById('cart-drawer');
            if (open) {
                drawer.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            } else {
                drawer.classList.add('hidden');
                document.body.style.overflow = '';
            }
        }

        // Toggle Mobile Menu
        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        }

        // Toast Notification Helper
        function showToast(htmlMessage) {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = "animate-slide-up bg-mocha-900 text-cream-50 text-xs px-4 py-3 rounded-2xl shadow-xl border border-mocha-700 flex items-center gap-2.5 max-w-xs";
            toast.innerHTML = `<span class="w-2 h-2 rounded-full bg-sage-400 flex-shrink-0"></span><span>${htmlMessage}</span>`;
            
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transition = 'opacity 0.3s ease';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // Inisialisasi Halaman
        window.addEventListener('DOMContentLoaded', () => {
            renderProducts();
            updateCartUI();
        });
    </script>
</body>
</html>
